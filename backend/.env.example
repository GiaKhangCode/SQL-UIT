# Database Connection String
# IMPORTANT: Update '@localhost' or your SQL Server instance name in the DATABASE_URL.
# If you use SQL Server authentication instead of Windows Authentication, add your username and password, 
# for example: mssql+pyodbc://username:password@localhost/SQLUIT?driver=...
DATABASE_URL="mssql+pyodbc://@localhost/SQLUIT?driver=ODBC+Driver+17+for+SQL+Server&Trusted_Connection=yes&TrustServerCertificate=yes"

# JWT Auth Configuration
SECRET_KEY="your-super-secret-jwt-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# Gemini API Key (Required for AI features)
GEMINI_API_KEY="your_gemini_api_key_here"
